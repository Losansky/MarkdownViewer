{
	"$schema": "./presentation.schema.json",
	"presentation": {
		"theme": "light",
		"fontFamily": "Segoe UI, system-ui, sans-serif",
		"fontSizePx": 16,
		"lineHeight": 1.6,
		"maxWidthPx": 1100,
		"codeFontFamily": "Cascadia Code, Consolas, monospace",
		"background": null,
		"foreground": null,
		"headingColor": null,
		"heading2Color": null
	},
	"editors": {
		"default": "Notepad++",
		"list": [
			{
				"id": "Notepad++",
				"name": "Notepad++",
				"command": "C:\\Program Files\\Notepad++\\notepad++.exe",
				"args": [
					"{{file}}"
				]
			},
			{
				"id": "vscode",
				"name": "Visual Studio Code",
				"command": "code",
				"args": [
					"{{file}}"
				]
			},
			{
				"id": "notepad",
				"name": "Notepad",
				"command": "notepad.exe",
				"args": [
					"{{file}}"
				]
			}
		]
	},
	"markdown": {
		"breaks": false,
		"linkify": true,
		"typographer": true,
		"html": false
	},
	"formats": {
		"mermaid": {
			"enabled": true,
			"fence": "mermaid",
			"theme": "default",
			"themeVariables": {
				"primaryColor": "#79c0ff",
				"primaryTextColor": "#0d1117",
				"primaryBorderColor": "#1f6feb",
				"secondaryColor": "#56d364",
				"secondaryTextColor": "#0d1117",
				"secondaryBorderColor": "#1a7f37",
				"tertiaryColor": "#e3b341",
				"tertiaryTextColor": "#0d1117",
				"tertiaryBorderColor": "#9a6700",
				"lineColor": "#57606a",
				"textColor": "#1f2328",
				"mainBkg": "#79c0ff",
				"nodeBorder": "#1f6feb",
				"clusterBkg": "#ddf4ff",
				"clusterBorder": "#54aeff",
				"titleColor": "#1f6feb",
				"edgeLabelBackground": "#ffffff",
				"actorBkg": "#ddf4ff",
				"actorBorder": "#1f6feb",
				"actorTextColor": "#0d1117",
				"signalColor": "#1a7f37",
				"noteBkgColor": "#ddf4ff",
				"noteBorderColor": "#0969da",
				"noteTextColor": "#0d1117",
				"errorBkgColor": "#ffebe9",
				"errorTextColor": "#cf222e",
				"critBkgColor": "#ffebe9",
				"critBorderColor": "#cf222e",
				"doneTaskBkgColor": "#dafbe1",
				"doneTaskBorderColor": "#1a7f37"
			},
			"themeVariablesDark": {
				"primaryColor": "#1f6feb",
				"primaryTextColor": "#ffffff",
				"primaryBorderColor": "#58a6ff",
				"secondaryColor": "#238636",
				"secondaryTextColor": "#ffffff",
				"secondaryBorderColor": "#3fb950",
				"tertiaryColor": "#d4a017",
				"tertiaryTextColor": "#0d1117",
				"tertiaryBorderColor": "#e3b341",
				"lineColor": "#8b949e",
				"textColor": "#e6edf3",
				"mainBkg": "#1f6feb",
				"nodeBorder": "#58a6ff",
				"clusterBkg": "#161b22",
				"clusterBorder": "#388bfd",
				"titleColor": "#58c4e8",
				"edgeLabelBackground": "#0d1117",
				"actorBkg": "#1f6feb",
				"actorBorder": "#58a6ff",
				"actorTextColor": "#ffffff",
				"signalColor": "#3fb950",
				"noteBkgColor": "#0d419d",
				"noteBorderColor": "#58a6ff",
				"noteTextColor": "#e6edf3",
				"errorBkgColor": "#3d1214",
				"errorTextColor": "#ff7b72",
				"critBkgColor": "#3d1214",
				"critBorderColor": "#f85149",
				"doneTaskBkgColor": "#238636",
				"doneTaskBorderColor": "#3fb950"
			},
			"securityLevel": "strict",
			"fontFamily": null
		},
		"math": {
			"enabled": true,
			"engine": "katex",
			"inlineDelimiters": [
				[
					"$",
					"$"
				],
				[
					"\\(",
					"\\)"
				]
			],
			"blockDelimiters": [
				[
					"$$",
					"$$"
				],
				[
					"\\[",
					"\\]"
				]
			],
			"throwOnError": false
		},
		"codeHighlight": {
			"enabled": true,
			"theme": "github",
			"lineNumbers": false
		},
		"admonitions": {
			"enabled": true,
			"syntax": "github",
			"types": {
				"note": {
					"title": "Note",
					"color": "#1f6feb",
					"icon": "info"
				},
				"tip": {
					"title": "Tip",
					"color": "#2da44e",
					"icon": "lightbulb"
				},
				"important": {
					"title": "Important",
					"color": "#8250df",
					"icon": "report"
				},
				"warning": {
					"title": "Warning",
					"color": "#9a6700",
					"icon": "alert"
				},
				"caution": {
					"title": "Caution",
					"color": "#cf222e",
					"icon": "stop"
				}
			}
		}
	}
}